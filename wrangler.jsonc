{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mintsitestudio",
  "account_id": "629ea57d26a608c11fc82b05ee423d79",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The Worker runs first so it can route by host and path (see src/worker.js header).
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  // 10:05 UTC = after midnight in every time zone from UTC+14 to UTC-10, so the new day's pages exist.
  "triggers": { "crons": ["5 10 * * *"] },
  "routes": [
    { "pattern": "mintsitestudio.com", "custom_domain": true },
    { "pattern": "www.mintsitestudio.com", "custom_domain": true },
    { "pattern": "demo.mintsitestudio.com", "custom_domain": true },
    { "pattern": "seller.mintsitestudio.com", "custom_domain": true }
  ]
}
